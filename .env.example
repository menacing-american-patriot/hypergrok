# Hypergrok configuration

# === Wallet ===
# Base asset held in the custody wallet funding the Hyperliquid account
WALLET_BASE_ASSET=USDC
# Starting balance available in the custody wallet (numbers use decimal format)
WALLET_INITIAL_BALANCE=100000
# Minimum balance that must remain in the custody wallet after exchange top ups
WALLET_MIN_CASH_RESERVE=10000

# === Risk Limits ===
# Maximum single-position notional size the strategy may request
RISK_MAX_POSITION=5000
# Maximum leverage allowed per trade
RISK_MAX_LEVERAGE=5
# Maximum total daily loss tolerance before rejecting new trades
RISK_MAX_DAILY_LOSS=10000

# === Hyperliquid Exchange ===
# Base REST endpoint for Hyperliquid (adjust for mainnet/testnet)
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
# API credentials with trading permissions
HYPERLIQUID_API_KEY=your-hyperliquid-api-key
HYPERLIQUID_API_SECRET=your-hyperliquid-api-secret
# Optional subaccount routing (omit if not used)
HYPERLIQUID_SUBACCOUNT=primary
# Exchange wallet address receiving deposits (optional)
HYPERLIQUID_ACCOUNT_ADDRESS=0xYourHyperliquidAddress

# === Grok AI Model ===
# Grok API endpoint for chat completions
GROK_API_URL=https://api.x.ai
# API key authorized for the selected Grok model
GROK_API_KEY=your-grok-api-key
# Optional overrides for model selection and sampling
GROK_MODEL=grok-2-latest
GROK_TEMPERATURE=0.15
GROK_MAX_TOKENS=512

# === Strategy Behavior ===
# Comma-separated list of markets to monitor
STRATEGY_TRADING_PAIRS=BTC-PERP,ETH-PERP
# Polling interval between Grok requests (seconds)
STRATEGY_POLL_INTERVAL=5
# Enable live order placement (set to "true" only after validation)
STRATEGY_ENABLE_LIVE=false
# Toggle autonomous maximum-profit mode (overrides manual risk limits when "true")
STRATEGY_AUTO_MAX_PROFIT=false
# Default leverage used when Grok omits it in auto mode
STRATEGY_AUTO_TARGET_LEVERAGE=4
# Fraction of available wallet collateral to deploy per trade in auto mode
STRATEGY_AUTO_POSITION_FRACTION=1.0
